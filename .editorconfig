root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Assembly: tabs between label/mnemonic/operand columns.
[*.{s,inc}]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
